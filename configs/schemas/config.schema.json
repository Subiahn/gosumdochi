{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gosumdochi config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_origin", "allowed_path_prefixes", "allowed_lab_cidrs", "accounts", "llm"],
  "properties": {
    "target_origin": { "type": "string", "pattern": "^https?://[^/@]+$" },
    "allowed_path_prefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" } },
    "allowed_lab_cidrs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": { "A": { "$ref": "#/$defs/account" }, "B": { "$ref": "#/$defs/account" } }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "base_url"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string", "minLength": 1 }
      }
    },
    "budgets": { "type": "object" },
    "output_dir": { "type": "string" }
  },
  "$defs": {
    "secretRef": { "type": "string", "pattern": "^(env|file):.+" },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username_ref", "password_ref", "login_path", "identity_path"],
      "properties": {
        "username_ref": { "$ref": "#/$defs/secretRef" },
        "password_ref": { "$ref": "#/$defs/secretRef" },
        "login_path": { "type": "string", "pattern": "^/" },
        "identity_path": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
