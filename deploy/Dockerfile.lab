FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/labapp ./cmd/labapp
COPY internal/labapp ./internal/labapp
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/labapp ./cmd/labapp

FROM alpine:3.22
RUN adduser -D -u 10001 lab
USER lab
COPY --from=build /out/labapp /usr/local/bin/labapp
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=2s --retries=10 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/labapp"]
